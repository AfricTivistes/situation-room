# =============================================================
# Dockerfile – Site Public Astro
# Build multi-stage pour réduire la taille de l'image finale
# =============================================================

# Étape 1 : Construction
FROM node:20-alpine AS builder

WORKDIR /app

# Installer pnpm
RUN npm install -g pnpm

# Copier les fichiers de configuration
COPY package.json pnpm-workspace.yaml ./
COPY packages/shared ./packages/shared
COPY apps/public ./apps/public

# Installer les dépendances
RUN pnpm install --frozen-lockfile

# Construire le site statique
RUN pnpm --filter public build

# Étape 2 : Serveur de fichiers statiques (image minimaliste)
FROM nginx:alpine AS runner

# Copier le build Astro vers nginx
COPY --from=builder /app/apps/public/dist /usr/share/nginx/html

# Configuration nginx simple pour servir du HTML statique
RUN echo 'server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    gzip on; \
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml; \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
