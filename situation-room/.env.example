# =============================================================
# Variables d'environnement – Situation Room / Africa ElectionLab
# =============================================================
# IMPORTANT : Ne jamais commiter le fichier .env !
# Copier ce fichier : cp .env.example .env
# Modifier TOUTES les valeurs avant de déployer en production.
# =============================================================

# ── Base de données PostgreSQL ─────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGER_CE_MOT_DE_PASSE
DB_NAME=situation_room

# ── NocoDB ────────────────────────────────────────────────
# Clé JWT pour l'authentification NocoDB (générer avec : openssl rand -hex 32)
JWT_SECRET=CHANGER_CETTE_CLE_SECRETE

# Token API NocoDB (généré depuis l'interface NocoDB après connexion)
# Nécessaire pour que le serveur webhooks puisse insérer des données
NOCODB_API_TOKEN=VOTRE_TOKEN_API_NOCODB

# ── Application ───────────────────────────────────────────
# Domaine de production (sans https://)
DOMAIN=votre-domaine.org

# URL de l'API NocoDB pour le dashboard (en développement)
VITE_API_URL=http://localhost:8080/api/v1/db/data/v1/situation_room

# Token API NocoDB côté front (même valeur que NOCODB_API_TOKEN)
# Exposé au navigateur – utiliser un token en lecture seule si possible
VITE_NOCODB_API_TOKEN=VOTRE_TOKEN_API_NOCODB

# Port du serveur webhooks (développement)
PORT=3000

# ── Canaux de signalement (optionnels selon votre déploiement) ──

# Telegram Bot Token (obtenu depuis @BotFather sur Telegram)
TELEGRAM_BOT_TOKEN=VOTRE_TOKEN_TELEGRAM

# Africa's Talking (SMS Gateway)
AFRICASTALKING_USERNAME=VOTRE_USERNAME
AFRICASTALKING_API_KEY=VOTRE_CLE_API

# WhatsApp Business API (Meta)
WHATSAPP_TOKEN=VOTRE_TOKEN_WHATSAPP
WHATSAPP_VERIFY_TOKEN=UN_MOT_SECRET_POUR_LA_VERIFICATION
